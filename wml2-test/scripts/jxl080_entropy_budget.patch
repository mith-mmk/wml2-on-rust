+impl SymbolReader {
+    /// Consumes the reader after final validation, transferring storage AND lease.
+    pub fn finish_with_budgeted_scratch(
+        mut self,
+        histograms: &BudgetedHistograms,
+        br: &mut BitReader,
+        scratch: &mut EntropyScratch,
+    ) -> Result<()> {
+        let budget = histograms
+            .0
+            ._context_map_lease
+            .as_ref()
+            .ok_or(Error::EntropyBudgetMismatch)?
+            .budget();
+        if !budget.same_budget(&scratch.budget) {
+            return Err(Error::EntropyBudgetMismatch);
+        }
+        if let SymbolReaderState::Lz77(state) = &self.state {
+            if !state
+                ._window_lease
+                .as_ref()
+                .is_some_and(|l| l.budget().same_budget(&budget))
+            {
+                return Err(Error::EntropyBudgetMismatch);
+            }
+        }
+        self.errors.check_for_error()?;
+        br.check_for_error()?;
+        if matches!(histograms.codes, Codes::Ans(_)) {
+            self.ans_reader.check_final_state()?;
+        }
+        if let SymbolReaderState::Lz77(state) = &mut self.state {
+            state.window.clear();
+            let old_data = std::mem::replace(&mut scratch.data, std::mem::take(&mut state.window));
+            drop(old_data); // Old backing allocation dies while its old lease is still held.
+            let old_lease = std::mem::replace(&mut scratch.lease, state._window_lease.take());
+            drop(old_lease);
+        }
+        Ok(())
+    }
+}
