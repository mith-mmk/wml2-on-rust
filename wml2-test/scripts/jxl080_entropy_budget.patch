+//! Evaluation: requested payload capacity of context maps and LZ77 windows only.
+//! Setup's Arc allocation, allocator overhead and other codec storage are excluded.
+use crate::error::{Error, Result};
+use std::ops::{Deref, DerefMut};
+use std::sync::{
+    Arc,
+    atomic::{AtomicUsize, Ordering},
+};
+
+#[derive(Debug, Clone)]
+pub struct EntropyBudget(Arc<State>);
+#[derive(Debug)]
+struct State {
+    limit: usize,
+    live: AtomicUsize,
+    peak: AtomicUsize,
+}
+impl EntropyBudget {
+    pub fn new(limit: usize) -> Self {
+        Self(Arc::new(State {
+            limit,
+            live: AtomicUsize::new(0),
+            peak: AtomicUsize::new(0),
+        }))
+    }
+    pub fn same_budget(&self, other: &Self) -> bool {
+        Arc::ptr_eq(&self.0, &other.0)
+    }
+    pub fn live_bytes(&self) -> usize {
+        self.0.live.load(Ordering::Relaxed)
+    }
+    pub fn peak_bytes(&self) -> usize {
+        self.0.peak.load(Ordering::Relaxed)
+    }
+    pub(crate) fn reserve(&self, bytes: usize) -> Result<Lease> {
+        let previous = self
+            .0
+            .live
+            .fetch_update(Ordering::Relaxed, Ordering::Relaxed, |live| {
+                live.checked_add(bytes).filter(|&next| next <= self.0.limit)
+            })
+            .map_err(|_| Error::EntropyBudgetExceeded)?;
+        self.0.peak.fetch_max(previous + bytes, Ordering::Relaxed);
+        Ok(Lease {
+            budget: self.clone(),
+            bytes,
+        })
+    }
+}
+#[derive(Debug)]
+pub(crate) struct Lease {
+    budget: EntropyBudget,
+    bytes: usize,
+}
+impl Lease {
+    pub(crate) fn budget(&self) -> EntropyBudget {
+        self.budget.clone()
+    }
+}
+impl Drop for Lease {
+    fn drop(&mut self) {
+        self.budget.0.live.fetch_sub(self.bytes, Ordering::Relaxed);
+    }
+}
+
+/// No Clone or Vec escape: a lease follows the storage until it is freed.
+/// Counts requested element capacity, not allocator-internal rounding or RSS.
+#[derive(Debug)]
+pub struct EntropyVec<T> {
+    // Field drop order matters: release storage before its reservation.
+    data: Vec<T>,
+    lease: Option<Lease>,
+    requested: usize,
+}
+impl<T: Copy> EntropyVec<T> {
+    pub(crate) fn with_capacity(capacity: usize, budget: Option<&EntropyBudget>) -> Result<Self> {
+        let layout = std::alloc::Layout::array::<T>(capacity).map_err(|_| Error::SizeOverflow)?;
+        let lease = budget.map(|b| b.reserve(layout.size())).transpose()?;
+        let mut data = Vec::new();
+        data.try_reserve_exact(capacity)?; // lease rolls back if allocator refuses
+        Ok(Self {
+            data,
+            lease,
+            requested: capacity,
+        })
+    }
+    pub(crate) fn push_reserved(&mut self, value: T) {
+        assert!(self.data.len() < self.requested); // never grow outside admission
+        self.data.push(value);
+    }
+    pub fn try_resize(&mut self, len: usize, value: T) -> Result<()> {
+        if self.lease.is_none() {
+            self.data
+                .try_reserve_exact(len.saturating_sub(self.data.len()))?;
+            self.data.resize(len, value);
+            self.requested = self.requested.max(len);
+            return Ok(());
+        }
+        if len <= self.requested {
+            self.data.resize(len, value);
+            return Ok(());
+        }
+        // Admit full replacement while the old backing store remains alive.
+        let budget = self.budget();
+        let mut next = Self::with_capacity(len, budget.as_ref())?;
+        next.data.extend_from_slice(&self.data);
+        next.data.resize(len, value);
+        *self = next; // old Vec dies before old lease
+        Ok(())
+    }
+    pub(crate) fn budget(&self) -> Option<EntropyBudget> {
+        self.lease.as_ref().map(|l| l.budget.clone())
+    }
+    pub(crate) fn into_parts(self) -> (Vec<T>, Option<Lease>) {
+        (self.data, self.lease)
+    }
+    pub(crate) fn into_unbudgeted(self) -> Vec<T> {
+        assert!(self.lease.is_none());
+        self.data
+    }
+    #[cfg(test)]
+    pub(crate) fn unbudgeted(data: Vec<T>) -> Self {
+        let requested = data.capacity();
+        Self {
+            data,
+            lease: None,
+            requested,
+        }
+    }
+}
+impl<T> Deref for EntropyVec<T> {
+    type Target = [T];
+    fn deref(&self) -> &[T] {
+        &self.data
+    }
+}
+impl<T> DerefMut for EntropyVec<T> {
+    fn deref_mut(&mut self) -> &mut [T] {
+        &mut self.data
+    }
+}
+
+// Preserve raw Vec access in histogram hot loops; keep its lease separately.
+pub(crate) fn resize_parts<T: Copy>(
+    data: &mut Vec<T>,
+    lease: &mut Option<Lease>,
+    len: usize,
+    value: T,
+) -> Result<()> {
+    if let Some(current) = lease {
+        let admitted = current
+            .bytes
+            .checked_div(std::mem::size_of::<T>())
+            .unwrap_or(usize::MAX);
+        if len <= admitted {
+            data.resize(len, value);
+            return Ok(());
+        }
+        let mut replacement = EntropyVec::with_capacity(len, Some(&current.budget))?;
+        replacement.data.extend_from_slice(data);
+        replacement.data.resize(len, value);
+        let (new_data, new_lease) = replacement.into_parts();
+        *data = new_data; // free old allocation before releasing its lease
+        *lease = new_lease;
+    } else {
+        data.try_reserve_exact(len.saturating_sub(data.len()))?;
+        data.resize(len, value);
+    }
+    Ok(())
+}
