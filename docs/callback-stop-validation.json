  "benchmark_harness_source": "use std::{hint::black_box, time::Instant};\nuse wml2::draw::image_from;\n\nfn hash(bytes: &[u8]) -> u64 {\n    bytes.iter().fold(0xcbf29ce484222325, |h, b| (h ^ u64::from(*b)).wrapping_mul(0x100000001b3))\n}\nfn main() {\n    let args: Vec<String> = std::env::args().collect();\n    let bytes = std::fs::read(&args[1]).unwrap();\n    let loops: usize = args[2].parse().unwrap();\n    let image = image_from(&bytes).unwrap();\n    let mut pixels = image.buffer.unwrap();\n    let frames = image.animation.unwrap_or_default();\n    for layer in &frames { pixels.extend_from_slice(&layer.buffer); }\n    let digest = hash(&pixels);\n    if let Some(path) = args.get(3) { std::fs::write(path, &pixels).unwrap(); }\n    for _ in 0..10 { black_box(image_from(black_box(&bytes)).unwrap()); }\n    let start = Instant::now();\n    for _ in 0..loops { black_box(image_from(black_box(&bytes)).unwrap()); }\n    println!(\"{{\\\"ns_per_decode\\\":{},\\\"loops\\\":{},\\\"frames\\\":{},\\\"hash\\\":{},\\\"pixel_bytes\\\":{}}}\", start.elapsed().as_nanos() as f64 / loops as f64, loops, frames.len(), digest, pixels.len());\n}\n",
