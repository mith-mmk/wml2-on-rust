+/// Explicit scratch ownership for the0.8 reusable ring. No Clone or Vec escape.
+#[derive(Debug)]
+pub struct EntropyScratch {
+    data: Vec<u32>,
+    lease: Option<Lease>,
+    budget: EntropyBudget,
+}
+impl EntropyScratch {
+    pub fn new(budget: &EntropyBudget) -> Self {
+        Self {
+            data: Vec::new(),
+            lease: None,
+            budget: budget.clone(),
+        }
+    }
+    pub fn retained_bytes(&self) -> usize {
+        self.data.capacity() * std::mem::size_of::<u32>()
+    }
+    pub fn clear(&mut self) {
+        drop(std::mem::take(&mut self.data));
+        drop(self.lease.take());
+    }
+}
